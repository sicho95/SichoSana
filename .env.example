# SichoSana : copier vers .env sur le NAS, jamais dans Git
# Le premier administrateur Sicho / sicho95@gmail.com se crée interactif
# Mot de passe temporaire saisi avec getpass, changement obligatoire ensuite
SICHOSANA_BIND=127.0.0.1
SICHOSANA_PORT=18887
SICHOSANA_PUBLIC_URL=https://yoga.sicho.cc.cd

# Fournisseur SMTP choisi sur le NAS ; ne pas publier ces informations.
SICHOSANA_SMTP_HOST=
SICHOSANA_SMTP_PORT=465
SICHOSANA_SMTP_SECURITY=ssl
SICHOSANA_SMTP_USER=
SICHOSANA_SMTP_PASSWORD=
SICHOSANA_SMTP_FROM=

# Source Sigastra autorisée pour site web avec crédit public /astro-source.html
# Si le fournisseur suspend l'accès, désactiver avec 0.
SICHOSANA_ASTRO_ENABLED=1
